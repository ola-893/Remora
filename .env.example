OPENAI_API_KEY=
OPENAI_MODEL=
QWEN_API_KEY=
QWEN_MODEL=
QWEN_REGION=
QWEN_BASE_URL=

# Optional NEAR AI Cloud key for the installed CLI's near-ai inference preset.
NEAR_AI_API_KEY=
